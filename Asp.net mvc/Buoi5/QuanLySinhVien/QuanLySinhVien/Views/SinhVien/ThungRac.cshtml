@model List<SinhVien>
@{ 
    ViewData["Title"] = "Thùng rác"; 
}

<h2>Thùng rác – sinh viên đã xóa</h2>

@if (TempData["ThongBao"] is string thongBao)
{
    <div class="alert alert-success">✔ @thongBao</div>
}

<table class="table table-striped">
    <thead class="table-dark">
        <tr>
            <th>Họ tên</th>
            <th>Lớp</th>
            <th>Email</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var sv in Model)
        {
            <tr>
                <td>@sv.HoTen</td>
                <td>@sv.Lop</td>
                <td>@sv.Email</td>
                <td>
                    <form asp-action="KhoiPhuc" asp-route-id="@sv.Id" method="post">
                        <button type="submit" class="btn btn-sm btn-success">↺ Khôi phục</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (Model.Count > 0)
{
    <form asp-action="DonThungRac" method="post" class="d-inline"
          onsubmit="return confirm('Xóa vĩnh viễn toàn bộ? Không thể hoàn tác!');">
        <button type="submit" class="btn btn-danger">Dọn sạch thùng rác</button>
    </form>
}

<a asp-action="Index" class="btn btn-secondary">Quay lại danh sách</a>