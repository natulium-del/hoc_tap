@model QuanLySinhVien.Models.SinhVien
@{
    ViewData["Title"] = "Thêm sinh viên (Không An Toàn)";
}

<h2>Thêm sinh viên mới - Phương pháp không an toàn</h2>
<p style="color: red"><strong>Lưu ý: Đây là bài tập thí nghiệm, phương pháp này không an toàn trong thực tế!</strong></p>

<form asp-action="ThemKhongAnToan" method="post">
    <div class="form-group">
        <label asp-for="HoTen">Họ tên:</label>
        <input asp-for="HoTen" class="form-control" />
        <span asp-validation-for="HoTen" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Lop">Lớp:</label>
        <input asp-for="Lop" class="form-control" />
        <span asp-validation-for="Lop" class="text-danger"></span>
    </div>
    
    <input type="hidden" name="KhoaId" value="1" />

    <button type="submit" class="btn btn-primary">Lưu</button>
    <a asp-action="Index" class="btn btn-secondary">Hủy</a>
</form>
